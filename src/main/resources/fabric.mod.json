{
	"schemaVersion": 1,
	"id": "peripheral",
	"version": "${version}",
	"name": "Peripheral",
	"description": "You are not alone. Footsteps that aren't yours, doors you didn't open, and something at the edge of your vision.",
	"authors": [
		"Bored"
	],
	"contact": {
		"sources": "https://github.com/BoredWasRobbed/peripheral",
		"issues": "https://github.com/BoredWasRobbed/peripheral/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/peripheral/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.bored.Peripheral"
		],
		"client": [
			"net.bored.client.PeripheralClient"
		],
		"fabric-datagen": [
			"net.bored.client.PeripheralDataGenerator"
		]
	},
	"mixins": [
		"peripheral.mixins.json",
		{
			"config": "peripheral.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
